{# Every interpolated string lands inside a Ruby string literal — pipe
   through |tojson so values containing quotes, newlines, backslashes,
   or interpolation syntax (`#{...}`) can't break out. The schema also
   regex-restricts these fields, but tojson is the load-bearing defence
   so future schema relaxations don't reopen the injection surface. #}
# Generated by LabForge — lab: {{ topology.name | tojson }}
# Network: {{ topology.network_cidr }} ({{ vagrant_nodes | length }} provisioned VMs)
# Provider: {{ topology.provider.value }}
# This file is regenerated each time you click "Generate Lab". Edit with care.
{% if external_nodes %}
#
# External / non-provisioned endpoints (not built by Vagrant):
{% for n in external_nodes %}
#   - {{ n.label | tojson }} ({{ n.type.value }}) — {{ n.config.ip }}
{% endfor %}
# These represent real-world systems (e.g. the public internet, SaaS APIs).
# Configure outbound rules in your firewall node to reach them.
{% endif %}

Vagrant.configure("2") do |config|
{% for n in vagrant_nodes %}
  config.vm.define {{ n.hostname | tojson }} do |m|
    m.vm.box = {{ n.box | tojson }}
    m.vm.hostname = {{ n.hostname | tojson }}
    m.vm.network "private_network", ip: {{ n.ip | tojson }}

    m.vm.provider :{{ vagrant_provider }} do |v|
      v.memory = {{ n.memory_mb }}
      v.cpus = {{ n.cpus }}
{% if vagrant_provider == "virtualbox" %}
      v.name = {{ ("labforge-" ~ (topology.name | replace(' ', '-') | lower) ~ "-" ~ n.hostname) | tojson }}
{% endif %}
    end

{% if n.is_windows %}
    m.vm.communicator = "winrm"
    m.winrm.transport = :plaintext
    m.winrm.basic_auth_only = true
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% else %}
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% endif %}
  end

{% endfor %}
end
