{# Every interpolated string lands inside a Ruby string literal — pipe
   through |tojson so values containing quotes, newlines, backslashes,
   or interpolation syntax (`#{...}`) can't break out. The schema also
   regex-restricts these fields, but tojson is the load-bearing defence
   so future schema relaxations don't reopen the injection surface. #}
# Generated by LabForge — lab: {{ topology.name | tojson }}
# Network: {{ topology.network_cidr }} ({{ vagrant_nodes | length }} provisioned VMs)
# Provider: {{ topology.provider.value }}
# This file is regenerated each time you click "Generate Lab". Edit with care.
{% if external_nodes %}
#
# External / non-provisioned endpoints (not built by Vagrant):
{% for n in external_nodes %}
#   - {{ n.label | tojson }} ({{ n.type.value }}) — {{ n.config.ip }}
{% endfor %}
# These represent real-world systems (e.g. the public internet, SaaS APIs).
# Configure outbound rules in your firewall node to reach them.
{% endif %}

Vagrant.configure("2") do |config|
{% for n in vagrant_nodes %}
  config.vm.define {{ n.hostname | tojson }} do |m|
    m.vm.box = {{ n.box | tojson }}
    m.vm.hostname = {{ n.hostname | tojson }}
    # Provisioners are uploaded over SSH/WinRM, so the shared folder is not
    # needed. Disabling it avoids SMB (needs admin on Windows hosts) and
    # guest-additions failures, and speeds up boot.
    m.vm.synced_folder ".", "/vagrant", disabled: true
    m.vm.network "private_network", ip: {{ n.ip | tojson }}

    m.vm.provider :{{ vagrant_provider }} do |v|
      v.memory = {{ n.memory_mb }}
      v.cpus = {{ n.cpus }}
{% if vagrant_provider == "virtualbox" %}
      # Linked clones share the box's base disk, so a second VM from the same
      # box costs seconds and megabytes instead of a full copy.
      v.linked_clone = true
      v.name = {{ ("labforge-" ~ (topology.name | replace(' ', '-') | lower) ~ "-" ~ n.hostname) | tojson }}
{% if n.gui %}
      # Visible VirtualBox window instead of headless — pair with a
      # desktop-environment role (e.g. "desktop-xfce") or this just shows
      # an empty console.
      v.gui = true
{% endif %}
{% if n.usb_vendor_id and n.usb_product_id %}
      # USB passthrough for a host device (e.g. a USB wifi adapter), picked
      # in the Launch dialog. This only attaches the device to the guest —
      # it does not configure networking, monitor mode, or install any
      # tooling; that's the node's role installer and/or you, inside the VM.
      v.customize ["modifyvm", :id, "--usb", "on"]
{% if usb_ehci_available %}
      v.customize ["modifyvm", :id, "--usb-ehci", "on"]
{% else %}
      # NOTE: the VirtualBox Extension Pack is not installed on the host that
      # generated this lab, so only a USB 1.1 (OHCI) controller is available.
      # A USB 2.0 device (most wifi dongles) still enumerates over OHCI, but
      # gets squeezed into full-speed mode — in practice its driver often
      # never finishes bringing up a usable wireless interface. Install the
      # matching Extension Pack from virtualbox.org/wiki/Downloads, then
      # re-generate this lab, if the passed-through adapter doesn't come up.
{% endif %}
      v.customize ["usbfilter", "add", "0",
        "--target", :id,
        "--name", {{ ("labforge-usb-" ~ n.hostname) | tojson }},
        "--vendorid", {{ ("0x" ~ n.usb_vendor_id) | tojson }},
        "--productid", {{ ("0x" ~ n.usb_product_id) | tojson }}]
{% endif %}
{% endif %}
    end

{% if n.is_windows %}
    # Windows boxes spend a long time on first boot (sysprep, updates); the
    # 5 minute default fails with "Timed out while waiting for the machine to boot".
    m.vm.boot_timeout = 900
    m.vm.graceful_halt_timeout = 180
    m.winrm.timeout = 1800
    m.winrm.retry_limit = 30
    m.vm.communicator = "winrm"
    m.winrm.transport = :plaintext
    m.winrm.basic_auth_only = true
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% else %}
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% endif %}
  end

{% endfor %}
end
