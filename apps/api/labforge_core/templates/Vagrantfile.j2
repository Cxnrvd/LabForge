{# Every interpolated string lands inside a Ruby string literal — pipe
   through |tojson so values containing quotes, newlines, backslashes,
   or interpolation syntax (`#{...}`) can't break out. The schema also
   regex-restricts these fields, but tojson is the load-bearing defence
   so future schema relaxations don't reopen the injection surface. #}
# Generated by LabForge — lab: {{ topology.name | tojson }}
# Network: {{ topology.network_cidr }} ({{ vagrant_nodes | length }} provisioned VMs)
# Provider: {{ topology.provider.value }}
# This file is regenerated each time you click "Generate Lab". Edit with care.
{% if external_nodes %}
#
# External / non-provisioned endpoints (not built by Vagrant):
{% for n in external_nodes %}
#   - {{ n.label | tojson }} ({{ n.type.value }}) — {{ n.config.ip }}
{% endfor %}
# These represent real-world systems (e.g. the public internet, SaaS APIs).
# Configure outbound rules in your firewall node to reach them.
{% endif %}

Vagrant.configure("2") do |config|
{% for n in vagrant_nodes %}
  config.vm.define {{ n.hostname | tojson }} do |m|
    m.vm.box = {{ n.box | tojson }}
{% if vagrant_provider == "vmware_desktop" %}
    # Vagrant's auto-detected architecture can hide every box version newer
    # than the 2023 ones (Vagrant Cloud tags current builds "amd64" and old
    # ones "unknown"); that handed us a 2023.4 Kali years behind the archive,
    # so a stale index and unsatisfiable desktop packages.
    m.vm.box_architecture = "amd64"
{% endif %}
    m.vm.hostname = {{ n.hostname | tojson }}
    # Provisioners are uploaded over SSH/WinRM, so the shared folder is not
    # needed. Disabling it avoids SMB (needs admin on Windows hosts) and
    # guest-additions failures, and speeds up boot.
    m.vm.synced_folder ".", "/vagrant", disabled: true
    m.vm.network "private_network", ip: {{ n.ip | tojson }}

    m.vm.provider :{{ vagrant_provider }} do |v|
{% if vagrant_provider == "vmware_desktop" %}
      # The VMware provider has no memory/cpus attributes; they are vmx keys.
      v.vmx["memsize"] = {{ n.memory_mb | string | tojson }}
      v.vmx["numvcpus"] = {{ n.cpus | string | tojson }}
      v.vmx["displayName"] = {{ ("labforge-" ~ (topology.name | replace(' ', '-') | lower) ~ "-" ~ n.hostname) | tojson }}
      # Always show the VM in the VMware Workstation window: headless VMs are
      # never added to its library, so they would run invisibly. Server nodes
      # still boot to a text console; only {{ "gui" }} nodes get a desktop.
      v.gui = true
{% if n.gui %}
      # Known VMware Workstation + Linux-guest bug (confirmed on this lab's
      # kalilinux/rolling + Xfce node, matches community reports of the same
      # modesetting/vmwgfx driver pairing): the guest's hardware cursor plane
      # doesn't composite correctly, so the pointer goes invisible (but
      # stays clickable) crossing from host to guest. Neither host-side vmx
      # setting alone was enough; both are needed:
      #   - mks.enable3d off: 2D-only SVGA, since the bug is in the 3D cursor path.
      #   - mks.noHostCursor: stop trying to sync to the host's own cursor and
      #     have VMware draw the guest cursor into the window itself.
      # The guest side also needs the matching fix (see desktop-xfce role,
      # which drops /etc/X11/xorg.conf.d/20-swcursor.conf to force a software
      # cursor instead of the modesetting driver's broken hardware one).
      v.vmx["mks.enable3d"] = "FALSE"
      v.vmx["mks.noHostCursor"] = "TRUE"
{% endif %}
{% if n.usb_vendor_id and n.usb_product_id %}
      # USB passthrough for a host device (e.g. a USB wifi adapter). VMware
      # connects it to this VM at power-on; unlike VirtualBox it can hand over
      # chips that re-enumerate or mishandle capture probing (the AltoBeam
      # 007a:888b never reaches a VirtualBox guest).
      v.vmx["usb.present"] = "TRUE"
      v.vmx["ehci.present"] = "TRUE"
      v.vmx["usb.autoConnect.device0"] = {{ ("0x" ~ n.usb_vendor_id ~ ":0x" ~ n.usb_product_id) | tojson }}
{% endif %}
{% else %}
      v.memory = {{ n.memory_mb }}
      v.cpus = {{ n.cpus }}
{% endif %}
{% if vagrant_provider == "virtualbox" %}
      # Linked clones share the box's base disk, so a second VM from the same
      # box costs seconds and megabytes instead of a full copy.
      v.linked_clone = true
      v.name = {{ ("labforge-" ~ (topology.name | replace(' ', '-') | lower) ~ "-" ~ n.hostname) | tojson }}
{% if n.gui %}
      # Visible VirtualBox window instead of headless — pair with a
      # desktop-environment role (e.g. "desktop-xfce") or this just shows
      # an empty console.
      v.gui = true
{% endif %}
{% if n.usb_vendor_id and n.usb_product_id %}
      # USB passthrough for a host device (e.g. a USB wifi adapter), picked
      # in the Launch dialog. This only attaches the device to the guest —
      # it does not configure networking, monitor mode, or install any
      # tooling; that's the node's role installer and/or you, inside the VM.
      v.customize ["modifyvm", :id, "--usb", "on"]
{% if usb_ehci_available %}
      v.customize ["modifyvm", :id, "--usb-ehci", "on"]
{% else %}
      # NOTE: the VirtualBox Extension Pack is not installed on the host that
      # generated this lab, so only a USB 1.1 (OHCI) controller is available.
      # A USB 2.0 device (most wifi dongles) still enumerates over OHCI, but
      # gets squeezed into full-speed mode — in practice its driver often
      # never finishes bringing up a usable wireless interface. Install the
      # matching Extension Pack from virtualbox.org/wiki/Downloads, then
      # re-generate this lab, if the passed-through adapter doesn't come up.
{% endif %}
      v.customize ["usbfilter", "add", "0",
        "--target", :id,
        "--name", {{ ("labforge-usb-" ~ n.hostname) | tojson }},
        "--vendorid", {{ ("0x" ~ n.usb_vendor_id) | tojson }},
        "--productid", {{ ("0x" ~ n.usb_product_id) | tojson }}]
{% endif %}
{% endif %}
    end

{% if n.is_windows %}
    # Windows boxes spend a long time on first boot (sysprep, updates); the
    # 5 minute default fails with "Timed out while waiting for the machine to boot".
    m.vm.boot_timeout = 900
    m.vm.graceful_halt_timeout = 180
    m.winrm.timeout = 1800
    m.winrm.retry_limit = 30
    m.vm.communicator = "winrm"
    m.winrm.transport = :plaintext
    m.winrm.basic_auth_only = true
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% else %}
{% if n.needs_kernel_upgrade %}
    # Newest kernel + matching headers, then reboot, so the driver role can
    # build an out-of-tree module against the kernel that is actually running.
    m.vm.provision "kernel-upgrade", type: "shell", privileged: true, reboot: true, inline: <<-'SCRIPT'
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get install -y linux-image-amd64 linux-headers-amd64 build-essential git bc usbutils
    SCRIPT
{% endif %}
{% if n.needs_backports_kernel %}
    # RTL8188FU's AP mode landed in mainline rtl8xxxu in 6.5, hardware crypto
    # and AP+STA concurrency in 6.9, and MFP (required for WPA3-SAE/OWE) only
    # in 6.10 — all newer than bookworm's own archive (still 6.1.x). Pull the
    # 6.12 kernel from bookworm-backports and reboot before the driver role
    # runs; firmware-realtek is installed here too, though it's stale for this
    # chip (the driver role fetches the one missing firmware file itself).
    m.vm.provision "backports-kernel-upgrade", type: "shell", privileged: true, reboot: true, inline: <<-'SCRIPT'
      export DEBIAN_FRONTEND=noninteractive
      echo 'deb http://deb.debian.org/debian bookworm-backports main' > /etc/apt/sources.list.d/bookworm-backports.list
      apt-get update -y
      apt-get install -y -t bookworm-backports linux-image-amd64 linux-headers-amd64
      apt-get install -y firmware-realtek build-essential git bc usbutils
    SCRIPT
{% endif %}
    m.vm.provision "shell",
      path: {{ n.provision_script | tojson }},
      privileged: true
{% if n.needs_kernel_upgrade %}
    # Runs on every up / reload / resume. After a pause (suspend) VMware
    # reconnects the USB dongle with fresh firmware state, so reload the driver
    # and bounce the AP; harmless when nothing changed.
    # Also covers a race we've hit on this node specifically: the
    # kernel-upgrade provisioner above reboots mid-provision (`reboot: true`),
    # and that reboot happens outside Vagrant's own boot sequence — so
    # Vagrant never re-runs the step that brings up the private_network
    # interface (eth1) after it. ifupdown's "auto eth1" entry is still in
    # /etc/network/interfaces, it just never got `ifup`'d, so eth1 sits
    # configured-but-down and the node becomes unreachable at its lab IP
    # until someone notices and runs `ifup eth1` by hand. `ifup -a` is a
    # no-op for interfaces already up, so this is safe to run every time.
    m.vm.provision "usb-radio-recover", type: "shell", run: "always", privileged: true, inline: <<-'SCRIPT'
      ifup -a 2>/dev/null || true
      for i in $(seq 1 30); do lsusb | grep -qi '007a:888b' && break; sleep 1; done
      lsmod | grep -q '^atbm6012bx' || modprobe atbm6012bx || true
      for i in $(seq 1 30); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done
      systemctl restart hostapd dnsmasq 2>/dev/null || true
    SCRIPT
{% endif %}
{% if n.needs_backports_kernel %}
    # Same rationale as the AltoBeam node's usb-radio-recover above: runs on
    # every up/reload/resume to reconnect after a suspend and re-ifup eth1 if
    # the backports-kernel-upgrade provisioner's mid-provision reboot raced it.
    m.vm.provision "usb-radio-recover", type: "shell", run: "always", privileged: true, inline: <<-'SCRIPT'
      ifup -a 2>/dev/null || true
      for i in $(seq 1 30); do lsusb | grep -qi '0bda:f179' && break; sleep 1; done
      lsmod | grep -q '^rtl8xxxu' || modprobe rtl8xxxu || true
      for i in $(seq 1 30); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done
      systemctl restart hostapd dnsmasq 2>/dev/null || true
    SCRIPT
{% endif %}
{% endif %}
  end

{% endfor %}
end
