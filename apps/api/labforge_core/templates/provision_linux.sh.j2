#!/usr/bin/env bash
# LabForge provisioner for {{ node.config.hostname }} ({{ node.type.value }})
# OS: {{ node.config.os.value }}  IP: {{ node.config.ip }}
# Generated by LabForge — edits below are safe; the file is re-emitted each
# time you click "Generate Lab".
set -uo pipefail

FAILED_BLOCKS=()
LOG=/var/log/labforge-provision.log
exec > >(tee -a "$LOG") 2>&1
echo "[$(date -Is)] === LabForge provisioner start for {{ node.config.hostname }} ==="

# Hostname — Vagrant already sets this from config.vm.hostname, but we keep a
# fallback so the script works outside Vagrant too.
hostnamectl set-hostname {{ node.config.hostname | bash_q }} 2>/dev/null || true

# Set the topology-defined password on the default vagrant user. We don't
# create a fresh user — the `vagrant` account already has sudo + SSH keys
# wired up by the Vagrant base box. The password is passed via printf so
# shlex-quoted values can't break out of the chpasswd line.
printf '%s\n' "vagrant:"{{ node.config.credentials.password | bash_q }} | chpasswd 2>/dev/null || true

{% if install_blocks %}
echo "[+] Applying {{ install_blocks | length }} role install block(s)..."
{% for block in install_blocks %}
echo "----- begin role: "{{ block.label | bash_q }}" ("{{ block.description | bash_q }}")" "-----"
(
set -e
{{ block.body }}
)
rc=$?
if [ "$rc" -ne 0 ]; then
    echo "[!] role '"{{ block.label | bash_q }}"' FAILED with exit code $rc"
    FAILED_BLOCKS+=("role "{{ block.label | bash_q }})
fi
echo "----- end role: "{{ block.label | bash_q }}" -----"
{% endfor %}
{% else %}
echo "[i] No roles attached — nothing to install beyond base OS."
{% endif %}

{% if cve_blocks %}
echo "[+] Applying {{ cve_blocks | length }} CVE provisioner(s)..."
{% for block in cve_blocks %}
echo "----- begin CVE: "{{ block.cve_id | bash_q }}" ("{{ block.description | bash_q }}")" "-----"
(
set -e
{{ block.script }}
)
rc=$?
if [ "$rc" -ne 0 ]; then
    echo "[!] CVE "{{ block.cve_id | bash_q }}" FAILED with exit code $rc"
    FAILED_BLOCKS+=("CVE "{{ block.cve_id | bash_q }})
fi
echo "----- end CVE: "{{ block.cve_id | bash_q }}" -----"
{% endfor %}
{% endif %}

if [ -n "${FAILED_BLOCKS[*]:-}" ]; then
    echo "[$(date -Is)] === LabForge provisioner FINISHED WITH ERRORS for {{ node.config.hostname }}: ${FAILED_BLOCKS[*]} ==="
    exit 1
fi
echo "[$(date -Is)] === LabForge provisioner complete for {{ node.config.hostname }} ==="
exit 0
