# LabForge provisioner for {{ node.config.hostname }} ({{ node.type.value }})
# OS: {{ node.config.os.value }}  IP: {{ node.config.ip }}
# Generated by LabForge. Edits below are safe; this is regenerated each
# time you click "Generate Lab".

$ErrorActionPreference = "Continue"
$VerbosePreference     = "Continue"

$failed = @()
$logDir  = "C:\Labforge"
$logPath = "$logDir\provision.log"
if (-not (Test-Path $logDir)) { New-Item -ItemType Directory -Path $logDir | Out-Null }
Start-Transcript -Path $logPath -Append | Out-Null

Write-Host "=== LabForge provisioner start for {{ node.config.hostname }} ==="

# Honour the topology hostname (Vagrant also sets this from m.vm.hostname).
$current = (Get-CimInstance Win32_ComputerSystem).Name
if ($current -ne {{ node.config.hostname | ps_q }}) {
    Rename-Computer -NewName {{ node.config.hostname | ps_q }} -Force -ErrorAction SilentlyContinue
}

# Set the topology-defined password on the existing vagrant user instead of
# creating a fresh account — Vagrant already has WinRM creds for vagrant.
$securePw = ConvertTo-SecureString {{ node.config.credentials.password | ps_q }} -AsPlainText -Force
try {
    Set-LocalUser -Name "vagrant" -Password $securePw -ErrorAction SilentlyContinue
} catch {
    Write-Host "[!] Could not set vagrant password: $_"
}

{% if install_blocks %}
Write-Host "[+] Applying {{ install_blocks | length }} role install block(s)..."
{% for block in install_blocks %}
Write-Host ("----- begin role: " + {{ block.label | ps_q }} + " (" + {{ block.description | ps_q }} + ") -----")
try {
{{ block.body | indent(4, True) }}
} catch {
    Write-Host ("[!] Role '" + {{ block.label | ps_q }} + "' failed: $_")
    $failed += ("role " + {{ block.label | ps_q }})
}
Write-Host ("----- end role: " + {{ block.label | ps_q }} + " -----")
{% endfor %}
{% else %}
Write-Host "[i] No roles attached."
{% endif %}

{% if cve_blocks %}
Write-Host "[i] CVE notes (Windows curated provisioners not bundled):"
{% for block in cve_blocks %}
Write-Host ("  - " + {{ block.cve_id | ps_q }} + ": " + {{ block.description | ps_q }})
{% endfor %}
{% endif %}

if ($failed.Count -gt 0) {
    Write-Host "=== LabForge provisioner FINISHED WITH ERRORS for {{ node.config.hostname }}: $($failed -join ', ') ==="
    Stop-Transcript | Out-Null
    exit 1
}
Write-Host "=== LabForge provisioner complete for {{ node.config.hostname }} ==="
Stop-Transcript | Out-Null
exit 0
