{
  "name": "labforge",
  "version": "0.1.0",
  "private": true,
  "description": "Diagram-driven virtual lab builder for cybersecurity professionals",
  "scripts": {
    "setup": "uv sync --project apps/api --extra dev --link-mode copy",
    "dev:web": "pnpm --filter @labforge/web dev",
    "dev:api": "cd apps/api && uv run uvicorn labforge_core.api.main:app --reload --port 8000",
    "dev": "node scripts/dev.mjs",
    "build:web": "pnpm --filter @labforge/web build",
    "lint": "pnpm --filter @labforge/web lint",
    "typecheck": "pnpm --filter @labforge/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
